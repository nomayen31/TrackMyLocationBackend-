# Backend environment variables. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# HTTP + Socket.IO port
PORT=5000

# Neon PostgreSQL connection string (use the pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Better Auth — a long random string (e.g. `openssl rand -hex 32`)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public URL of this backend (must match how the frontend reaches it)
BETTER_AUTH_URL=http://localhost:5000

# Public URL of the frontend — used to build invite links / QR targets
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------- LiveKit
# LiveKit powers the Discord-style group voice rooms. The URL and key are
# non-secret, but the API SECRET must never be committed or exposed to the
# browser — it is only used server-side to sign room-scoped access tokens.
# Get these from https://cloud.livekit.io (or your self-hosted instance).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Optional: extra allowed CORS origins (comma separated). Any localhost port
# is allowed by default, so this is only needed for a deployed frontend.
# CORS_ORIGINS=https://your-frontend.example.com
