# Backend environment variables. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# HTTP + Socket.IO port
PORT=5000

# Neon PostgreSQL connection string (use the pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Better Auth — a long random string (e.g. `openssl rand -hex 32`)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public URL of this backend (must match how the frontend reaches it)
BETTER_AUTH_URL=http://localhost:5000

# Public URL of the frontend — used to build invite links / QR targets
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------- LiveKit
# LiveKit powers the Discord-style group voice rooms. The URL and key are
# non-secret, but the API SECRET must never be committed or exposed to the
# browser — it is only used server-side to sign room-scoped access tokens.
# Get these from https://cloud.livekit.io (or your self-hosted instance).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# ---------------------------------------------------------------- LAN / hotspot
# Ignored unless LAN_MODE=true. See docs/HOTSPOT_SETUP.md.
#
# LAN_MODE switches the backend into the offline Raspberry Pi hotspot mode:
# no cloud auth/database, subnet-based discovery, WebRTC mesh group voice, and
# the built frontend served from this same origin.
LAN_MODE=false

# Signing secret for LAN identity tokens (long random string). If unset, a
# random secret is generated at boot (tokens then expire on restart).
LAN_SECRET=

# Name shown in the hotspot UI.
LAN_NETWORK_NAME=Hotspot

# Max people in one voice mesh. Pi 4/5: 6-8 · Pi Zero 2 W: 4.
LAN_MAX_PEERS=6

# How long a device stays "nearby" without a heartbeat (ms).
LAN_PRESENCE_TTL_MS=45000

# Path to the built frontend served by the Pi. Defaults to ../../Frontend/dist.
# FRONTEND_DIST=/home/pi/TrackmyLocation/Frontend/dist

# HTTPS is REQUIRED for microphone access on a LAN IP. Provide a certificate
# whose SAN includes the Pi's IP (see docs/HOTSPOT_SETUP.md).
# LAN_HTTPS_CERT=/etc/triptracker/cert.pem
# LAN_HTTPS_KEY=/etc/triptracker/key.pem

# Optional: extra allowed CORS origins (comma separated). Any localhost port
# is allowed by default, so this is only needed for a deployed frontend.
# CORS_ORIGINS=https://your-frontend.example.com
